# ═══════════════════════════════════════════════════════════════════════
# تقنيات سوفت Pro — Cloud Sync Server (Environment Variables Template)
# ═══════════════════════════════════════════════════════════════════════
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية
# لا ترفع ملف .env على GitHub — احتفظ به محلياً فقط
# ═══════════════════════════════════════════════════════════════════════

# ── قاعدة بيانات Neon PostgreSQL ──
# احصل عليها من: https://console.neon.tech → Project → Connection Details → Pooled connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ── إعدادات السيرفر ──
NODE_ENV=production
PORT=10000

# ── مفتاح JWT (استخدم: openssl rand -hex 32) ──
JWT_SECRET=your_random_64_char_secret_here
JWT_EXPIRES_IN=30d

# ── مفتاح API لتسجيل الأجهزة الأولى ──
API_KEY=your_shared_api_key_for_device_registration

# ── رابط السيرفر العام على Render ──
PUBLIC_URL=https://your-app.onrender.com

# ── CORS ──
CORS_ORIGINS=*

# ── حدود المعدل ──
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

# ── حجم الحمل الأقصى ──
MAX_BODY_SIZE=50mb
