# ============================================================
# تقنيات سوفت Pro v5.7.0 - Render Environment Variables
# ============================================================

# قاعدة بيانات Neon PostgreSQL (مطلوبة!)
# احصل عليها من https://console.neon.tech/ → مشروعك → Connection Details
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# JWT Secret (يجب أن يتطابق مع lib/security-native.js في الديسكتوب)
JWT_SECRET=ts-pro-v5.7.0-shared-secret-2025-abdulrahman-al-akwa

# Admin Panel Credentials (لوحة الإدارة على /admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_pass_1234
ADMIN_SESSION_SECRET=change_me_random_session_secret

# Server Config
PORT=10000
HOST=0.0.0.0
NODE_ENV=production

# CORS
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
