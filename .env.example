# ============================================================
# تقنيات سوفت Pro v5.7.0 - Render Environment Variables
# ============================================================

# قاعدة بيانات Neon PostgreSQL (مطلوبة!)
# احصل عليها من https://console.neon.tech/ → مشروعك → Connection Details
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# ════════════════════════════════════════════════════════════════════════
# JWT Secret — ⚠️⚠️ حاسم جداً: يجب أن يطابق السرّ المخبوز في تطبيق الديسكتوب ⚠️⚠️
# ════════════════════════════════════════════════════════════════════════
# [إصلاح v6.9.2 — حلقة معالج الإعداد]
# سبب مشكلة "لا يظهر تم التفعيل ويعود المعالج للظهور" كان عدم تطابق هذا السرّ
# مع السرّ داخل تطبيق الديسكتوب. الخادم كان يوقّع التوكن بسرّ مختلف فيفشل
# التحقق في الديسكتوب ولا يُحفظ الترخيص.
#
# ✅ الحل: انسخ القيمة التالية *حرفياً* إلى Render → Environment → JWT_SECRET
#    ثم اضغط Manual Deploy. هذه القيمة نفسها مخبوزة (مشفّرة) داخل EXE v6.9.2.
#
JWT_SECRET=tspro-b850a8f07324a984734f1883cc8317cdb33a4fd156b367081bf60bdf2176171b
#
# ملاحظة: هذه ليست قيمة عشوائية تختارها أنت — يجب أن تكون *بالضبط* كما بالأعلى
# وإلا عادت مشكلة حلقة التفعيل. (السرّ قوي وعشوائي أصلاً وغير الافتراضي المكشوف.)
# ════════════════════════════════════════════════════════════════════════

# Admin Panel Credentials (لوحة الإدارة على /admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_pass_1234
ADMIN_SESSION_SECRET=change_me_random_session_secret

# ════════════════════════════════════════════════════════════════════════
# API_KEY — مفتاح النسخ الاحتياطي السحابي (v6.9.3 — الخيار ب)
# ════════════════════════════════════════════════════════════════════════
# يُستخدم في نقطة /api/auth/register (رأس X-API-Key) لتسجيل الأجهزة قبل رفع
# النسخ السحابية. يجب أن يطابق المفتاح المخبوز في تطبيق الديسكتوب.
#
# القيمة الافتراضية (مطابقة للمخبوزة في التطبيق) — تعمل مباشرةً دون ضبط:
#   technologies_soft_pro_default_api_key_change_me_before_deploy
#
# ⚠️ إن تركت هذا المتغيّر فارغاً على Render، سيستخدم الخادم القيمة الافتراضية
#    أعلاه وهي نفسها في التطبيق، فيعمل النظام. لرفع الأمان يمكنك تغييره لاحقاً
#    بشرط تغييره في التطبيق أيضاً (يتطلب إعادة بناء EXE). للتشغيل الحالي اتركه فارغاً.
# API_KEY=technologies_soft_pro_default_api_key_change_me_before_deploy
# ════════════════════════════════════════════════════════════════════════

# Server Config
PORT=10000
HOST=0.0.0.0
NODE_ENV=production

# CORS
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
