# ============================================================
# تقنيات سوفت Pro v5.7.0 - Render Environment Variables
# ============================================================

# قاعدة بيانات Neon PostgreSQL (مطلوبة!)
# احصل عليها من https://console.neon.tech/ → مشروعك → Connection Details
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# JWT Secret (يجب أن يتطابق مع السرّ في الديسكتوب)
# ⚠️ v6.9.1: استخدم قيمة قوية عشوائية (≥32 حرفاً). لا تشارك هذه القيمة أو ترفعها للمستودع.
# مثال لتوليد قيمة: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ضع_هنا_سرّاً_قوياً_عشوائياً_لا_يقل_عن_32_حرفاً

# Admin Panel Credentials (لوحة الإدارة على /admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_pass_1234
ADMIN_SESSION_SECRET=change_me_random_session_secret

# Server Config
PORT=10000
HOST=0.0.0.0
NODE_ENV=production

# CORS
CORS_ORIGINS=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
